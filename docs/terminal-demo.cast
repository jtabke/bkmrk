[0.0, "o", "bm: plain-text bookmarks\r\nA working-tree wheel, a disposable store, and no browser launches.\r\n\r\n"]
[0.7, "o", "$ uv pip install --python \"$DEMO/venv/bin/python\" \"$DEMO/dist/bkmrk-0.3.1-py3-none-any.whl\"\r\n"]
